// ถ้าสินค้าเก่าไม่มีค่า productType จะถือว่าเป็น "สินค้าทั่วไป" (normal) โดยปริยาย
function getProductsByType(type) {
    if (typeof products === 'undefined' || !Array.isArray(products)) return [];
    return products.filter(p => (p.productType || 'normal') === type);
}

// สินค้าทั่วไป -> #normalProductGrid
function renderNormalProducts() {
    renderProducts(getProductsByType('normal'), 'normalProductGrid');
}

// สินค้าแนะนำ -> #productGrid
function renderRecommendedProducts() {
    renderProducts(getProductsByType('recommended'), 'productGrid');
}

// สินค้ายอดฮิต -> #hotProductGrid (เรียงตามยอดขายมากไปน้อยภายในกลุ่มที่ติดแท็ก "ยอดฮิต")
function renderHotProducts() {
    const hotList = getProductsByType('hot')
        .sort((a, b) => (b.sold || 0) - (a.sold || 0));
    renderProducts(hotList, 'hotProductGrid');
}

// สินค้า Flash Sale -> #flashSaleProductGrid
function renderFlashSaleProducts() {
    renderProducts(getProductsByType('flashsale'), 'flashSaleProductGrid');
}

// เรียก Render ทุกโซนตามชนิดสินค้าพร้อมกันทีเดียว
function renderAllTypedSections() {
    renderNormalProducts();
    renderRecommendedProducts();
    renderHotProducts();
    renderFlashSaleProducts();
}

