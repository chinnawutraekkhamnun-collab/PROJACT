    "หน้าด้านก็อป โค้ดนี้ใช้เหงื่อและแรงสร้างนะ!",
    "ก็อปไปก็ไม่เจริญหรอก สภาพ!",
    "อย่าหาทำ! คิดเองเขียนเองไม่เป็นหรือไง?",
    "แจ้งเตือน: ตรวจพบพฤติกรรมขี้ก็อปเกรดต่ำ!"
];

let currentInsult = insultList[0];

// ฟังก์ชันสุ่มคำด่าใหม่
function randomizeWarningText() {
    const randomIndex = Math.floor(Math.random() * insultList.length);
    currentInsult = insultList[randomIndex];
    
    const displayEl = document.getElementById('warningTextDisplay');
    if (displayEl) {
        displayEl.innerText = currentInsult;
    }
}

// ฟังก์ชันเปิด Modal เตือนเต็มหน้าจอ
function showCopyWarning() {
    randomizeWarningText(); // สุ่มคำด่าใหม่ทุกครั้งที่เปิด Modal
    const modal = document.getElementById('copyWarningModal');
    if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }
}

// ฟังก์ชันปิด Modal เตือน
function closeCopyWarning() {
    const modal = document.getElementById('copyWarningModal');
    if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }
}

(function() {
    // 1. ดักจับปุ่ม F12, Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+U
    document.addEventListener('keydown', function(e) {
        const isCmdOrCtrl = e.ctrlKey || e.metaKey;
        
        if (
            e.key === 'F12' || 
            e.keyCode === 123 || 
            (isCmdOrCtrl && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.keyCode === 73)) ||
            (isCmdOrCtrl && e.shiftKey && (e.key === 'J' || e.key === 'j' || e.keyCode === 74)) ||
            (isCmdOrCtrl && e.shiftKey && (e.key === 'C' || e.key === 'c' || e.keyCode === 67)) ||
            (isCmdOrCtrl && (e.key === 'U' || e.key === 'u' || e.keyCode === 85))
        ) {
            e.preventDefault();
            e.stopPropagation();
            showCopyWarning();
            return false;
        }
    });

    // 2. ดักจับการคลิกขวา (Right Click)
    document.addEventListener('contextmenu', function(e) {
        e.preventDefault();
        showCopyWarning();
        return false;
    });

    // 3. ป้องกันการ Copy (เปลี่ยนข้อความใน Clipboard เป็นคำด่าที่สุ่มมา + แสดง Modal)
    document.addEventListener('copy', function(e) {
        e.preventDefault();
        if (e.clipboardData) {
            e.clipboardData.setData('text/plain', currentInsult);
        } else if (window.clipboardData) {
            window.clipboardData.setData('Text', currentInsult);
        }
        showCopyWarning();
    });

    // 4. ล้าง Console และพ่นข้อความเตือนใน Console
    setInterval(function() {
        console.clear();
        console.log("%c" + currentInsult, "color: red; font-size: 28px; font-weight: bold; -webkit-text-stroke: 1px black;");
    }, 2000);
})();
