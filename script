// บันทึก/เพิ่ม/แก้ไข สินค้า
async function saveProduct(e) {
    if (e) e.preventDefault();

    const editId = document.getElementById('editProductId').value;
    let productIdNum;

    if (editId) {
        // กรณี "แก้ไข" สินค้าเดิม
        productIdNum = Number(editId);
    } else {
        // กรณี "เพิ่มใหม่" -> คัดกรองเอาเฉพาะ ID ที่เป็นตัวเลขสมบูรณ์มาหาค่าสูงสุด
        const validIds = products
            .map(p => Number(p.id))
            .filter(id => !isNaN(id) && id > 0);

        const maxId = validIds.length > 0 ? Math.max(...validIds) : 0;
        productIdNum = maxId + 1;
    }

    // กำหนด Document ID ใน Firestore ให้เป็นรูปแบบ id-1, id-2, id-3...
    const customDocId = `id-${productIdNum}`;

    // ถ้าเป็นการแก้ไขสินค้าเดิม ให้คงค่ายอดขาย (sold) เดิมไว้ ไม่รีเซ็ตเป็น 0
    const existingProduct = editId ? products.find(p => String(p.id) === String(editId)) : null;
    const soldCount = existingProduct ? (existingProduct.sold || 0) : 0;

    const productData = {
        id: productIdNum, // บันทึก id เป็นตัวเลขเรียงกัน
        name: document.getElementById('pName').value.trim(),
        category: document.getElementById('pCategory').value,
        productType: document.getElementById('pSubCategory').value || 'normal', // ชนิดสินค้า: normal / recommended / hot / flashsale
        brand: document.getElementById('pBrand').value.trim(),
        oldPrice: parseFloat(document.getElementById('pOldPrice').value) || 0,
        price: parseFloat(document.getElementById('pPrice').value) || 0,
        specs: document.getElementById('pSpecs').value.trim(),
        img: document.getElementById('pImg').value.trim(),
        warranty: document.getElementById('pWarranty').value.trim() || '1Y',
        sold: soldCount
    };

    try {
        await db.collection("products").doc(customDocId).set(productData, { merge: true });

        alert(`บันทึกข้อมูลสำเร็จ! รหัสสินค้า ID: ${productIdNum}`);
        if (typeof closeAdminModal === 'function') closeAdminModal();

        await fetchProductsFromFirebase(); // ดึงข้อมูลใหม่
    } catch (error) {
        console.error("เกิดข้อผิดพลาดในการบันทึกสินค้า:", error);
        alert("ไม่สามารถบันทึกข้อมูลได้ กรุณาลองใหม่อีกครั้ง");
    }
}

// แก้ไขฟังก์ชัน editProduct ให้เปรียบเทียบ ID ได้ทั้งชนิด String และ Number
function editProduct(id) {
    // เปลี่ยนจาก prod.id === id เป็น String(prod.id) === String(id)
    const p = products.find(prod => String(prod.id) === String(id));
    if (!p) {
        console.error("ไม่พบข้อมูลสินค้า ID:", id);
        return;
    }

    document.getElementById('editProductId').value = p.id;
    document.getElementById('pName').value = p.name;
    document.getElementById('pCategory').value = p.category;
    document.getElementById('pSubCategory').value = p.productType || 'normal';
    document.getElementById('pBrand').value = p.brand;
    document.getElementById('pOldPrice').value = p.oldPrice;
    document.getElementById('pPrice').value = p.price;
    document.getElementById('pSpecs').value = p.specs;
    document.getElementById('pImg').value = p.img;
    document.getElementById('pWarranty').value = p.warranty || '1Y';

    const title = document.getElementById('adminFormTitle');
    if (title) title.innerText = translations[currentLang].editProductTitle;

    const modal = document.getElementById('adminModal');
    if (modal) modal.classList.remove('hidden');
}

// ลบสินค้า
async function deleteProduct(id) {
    const confirmMsg = (typeof currentLang !== 'undefined' && currentLang === 'th')
        ? 'คุณต้องการลบสินค้านี้ใช่หรือไม่?'
        : 'Are you sure you want to delete this product?';

    if (confirm(confirmMsg)) {
        try {
            // ค้นหาสินค้าเพื่อดึง firestoreId หรือใช้รูปแบบ id-${id}
            const item = products.find(p => String(p.id) === String(id));
            const docIdToDelete = (item && item.firestoreId) ? item.firestoreId : `id-${id}`;

            await db.collection("products").doc(docIdToDelete).delete();
            alert("ลบสินค้าเรียบร้อยแล้ว!");

            await fetchProductsFromFirebase();
        } catch (error) {
            console.error("เกิดข้อผิดพลาดในการลบสินค้า:", error);
            alert("ไม่สามารถลบสินค้าได้ กรุณาลองใหม่อีกครั้ง");
        }
    }
}
// ==========================================
// AUTO SCROLL CONTINUOUS (เลื่อนซ้ายตลอดเวลาแบบไหลลื่น)
// ==========================================
// เก็บ Interval แยกตาม gridId เพื่อให้เลื่อนได้พร้อมกันหลายแถว (แนะนำ + ยอดฮิต)
const productScrollIntervals = {};

function startProductAutoScroll(gridId = 'productGrid') {
    const grid = document.getElementById(gridId);
    if (!grid) return;

    // เคลียร์ Interval เก่าของแถวนี้เพื่อป้องกันการรันซ้อน
    if (productScrollIntervals[gridId]) clearInterval(productScrollIntervals[gridId]);

    // เลื่อนทีละ 1px ทุกๆ 15ms เพื่อความลื่นไหลระดับ 60fps
    productScrollIntervals[gridId] = setInterval(() => {
        // เช็คว่าเลื่อนจนสุดขอบขวาแล้วหรือยัง
        const maxScrollLeft = grid.scrollWidth - grid.clientWidth;

        if (grid.scrollLeft >= maxScrollLeft - 2) {
            // เมื่อสุดขอบ ให้รีเซ็ตกลับไปซ้ายสุดทันที
            grid.scrollLeft = 0;
        } else {
            // ขยับไปทางขวาเรื่อยๆ ทีละ 1.5px
            grid.scrollLeft += 1.5;
        }
    }, 15);
}

function stopProductAutoScroll(gridId = 'productGrid') {
    if (productScrollIntervals[gridId]) {
        clearInterval(productScrollIntervals[gridId]);
    }
}

// เริ่มทำงานเมื่อ Render สินค้าเสร็จสิ้น และผูก Event สัมผัส (ใช้ได้กับหลายแถว)
function initAutoScrollEvents(gridId = 'productGrid') {
    const grid = document.getElementById(gridId);
    if (!grid) return;

    startProductAutoScroll(gridId);

    // หยุดเลื่อนชั่วคราวเมื่อผู้ใช้เอาเมาส์ชี้ หรือแตะสัมผัสบนมือถือ
    grid.addEventListener('mouseenter', () => stopProductAutoScroll(gridId));
    grid.addEventListener('mouseleave', () => startProductAutoScroll(gridId));
    grid.addEventListener('touchstart', () => stopProductAutoScroll(gridId), { passive: true });
    grid.addEventListener('touchend', () => startProductAutoScroll(gridId));
}

// เรียกฟังก์ชันหลังจากที่ดึงข้อมูลสินค้ามาแสดงเรียบร้อยแล้ว
document.addEventListener('DOMContentLoaded', () => {
    // หน่วงเวลาเล็กน้อยให้ Firebase / DOM สร้างการแสดงผลให้เสร็จก่อนเริ่มเลื่อน
    setTimeout(() => {
        initAutoScrollEvents('productGrid');
        initAutoScrollEvents('hotProductGrid');
        initAutoScrollEvents('flashSaleProductGrid');
        initAutoScrollEvents('normalProductGrid');
    }, 1000);
});
