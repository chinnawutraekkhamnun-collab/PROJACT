<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>COM PANG - Gaming & Hardware Store</title>
    <!-- Tailwind CSS CDN & Font Awesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
    <link rel="icon" type="image/x-icon" href="/icon/favicon.png"">
</head>

<body class=" bg-slate-950 text-gray-100 font-sans antialiased transition-colors duration-300">

    <div class="snow-container" aria-hidden="true">
        <div class="snowflake">❄</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
        <div class="snowflake">❄</div>
        <div class="snowflake">❅</div>
        <div class="snowflake">❆</div>
    </div>

    <!-- Header Navigation Bar -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 shadow-md">
        <!-- Top Info Bar -->
        <div
            class="bg-black/60 text-gray-300 text-xs py-1.5 px-3 sm:px-4 flex justify-between items-center border-b border-slate-800/50">
            <div class="flex items-center gap-3">

            </div>
            <div class="flex items-center gap-3">
                <!-- ปุ่มสลับภาษา -->


            </div>
        </div>

        <!-- Main Header -->
        <div
            class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 sm:py-3 flex flex-wrap md:flex-nowrap justify-between items-center gap-2 sm:gap-4">
            <!-- Logo & Actions row in Mobile -->
            <div class="flex justify-between items-center w-full md:w-auto">
                <a href="#" onclick="filterCategory('all')"
                    class="text-2xl sm:text-3xl font-black italic tracking-wider text-white flex items-center group">
                    COM <span class="text-cyan-400 ml-1 group-hover:text-blue-500 transition">PANG</span>
                </a>

                <!-- Mobile Quick Action (Theme, Auth, Cart) -->
                <div class="flex items-center gap-2 md:hidden">
                    <button onclick="toggleTheme()"
                        class="p-2 rounded-lg bg-slate-800 text-yellow-400 border border-slate-700">
                        <i class="fa-solid fa-sun text-sm"></i>
                    </button>
                    <button onclick="toggleAuthModal()"
                        class="p-2 rounded-lg bg-slate-800 text-cyan-400 border border-slate-700">
                        <i class="fa-regular fa-user text-sm"></i>
                    </button>
                    <button onclick="toggleCartModal()"
                        class="relative p-2 rounded-lg bg-slate-800 text-gray-200 border border-slate-700">
                        <i class="fa-solid fa-cart-shopping text-sm"></i>
                        <span
                            class="cart-badge-mobile absolute -top-1.5 -right-1.5 bg-cyan-500 text-black font-extrabold text-[10px] rounded-full w-4 h-4 flex items-center justify-center">0</span>
                    </button>
                </div>
            </div>

            <!-- Search Bar -->
            <div class="w-full md:flex-1 md:max-w-2xl order-3 md:order-2">
                <div class="relative">
                    <input type="text" id="searchInput" onkeyup="filterProducts()"
                        placeholder="ค้นหาสินค้า เกมมิ่งเกียร์ สเปกคอม..." data-i18n-ph="searchPlaceholder"
                        class="w-full pl-9 pr-4 py-1.5 sm:py-2 border border-slate-700 rounded-full bg-slate-800/80 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-400 text-xs sm:text-sm transition">
                    <i
                        class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 sm:top-3 text-cyan-400 text-xs sm:text-sm"></i>
                </div>
            </div>

            <!-- Desktop Actions -->
            <div class="hidden md:flex items-center gap-4 text-gray-200 order-2 md:order-3">
                <button id="themeToggleBtn" onclick="toggleTheme()"
                    class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-yellow-400 border border-slate-700 transition"
                    title="สลับโหมดสว่าง/มืด">
                    <i id="themeIcon" class="fa-solid fa-sun text-lg"></i>
                </button>

                <div class="flex items-center gap-3">
                    <div id="userInfoContainer" class="flex items-center gap-2">
                        <button onclick="toggleAuthModal()"
                            class="flex items-center gap-2 hover:text-cyan-400 text-sm font-medium transition">
                            <i class="fa-regular fa-user text-xl text-cyan-400"></i>
                            <span id="userStatusText" class="inline" data-i18n="loginRegister">เข้าสู่ระบบ /
                                สมัครสมาชิก</span>
                        </button>
                    </div>
                    <button id="logoutBtn" onclick="handleLogout()"
                        class="hidden text-xs bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 px-2.5 py-1 rounded-lg transition flex items-center gap-1">
                        <i class="fa-solid fa-right-from-bracket"></i> <span data-i18n="logout">ออกจากระบบ</span>
                    </button>
                </div>

                <button onclick="toggleCartModal()" class="relative p-2 text-gray-200 hover:text-cyan-400 transition">
                    <i class="fa-solid fa-cart-shopping text-2xl"></i>
                    <span id="cartCount"
                        class="absolute -top-1 -right-1 bg-cyan-500 text-black font-extrabold text-xs rounded-full w-5 h-5 flex items-center justify-center shadow-lg">0</span>
                </button>
                <button onclick="toggleLanguage()"
                    class="flex items-center gap-1 hover:text-cyan-400 transition font-bold bg-slate-800 px-2 py-0.5 rounded border border-slate-700 text-[11px] sm:text-xs">
                    <i class="fa-solid fa-globe text-cyan-400"></i>
                    <span id="langLabel">TH</span>
                </button>
            </div>
        </div>

        <!-- Category & Brand Menu Bar -->
        <div class="border-t border-slate-800 bg-slate-900/90 backdrop-blur-md">
            <div
                class="max-w-7xl mx-auto px-3 sm:px-4 flex items-center gap-2 sm:gap-4 text-xs sm:text-sm font-medium overflow-x-auto py-2 no-scrollbar">
                <button onclick="filterCategory('all')"
                    class="bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 hover:bg-cyan-500/20 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg flex items-center gap-1.5 font-semibold transition shrink-0">
                    <i class="fa-solid fa-border-all"></i> <span data-i18n="allProducts">หน้าแรก</span>
                </button>

                <!-- หมวดหมู่สินค้า (Categories) -->
                <div class="flex items-center gap-1 sm:gap-2 border-r border-slate-700 pr-2 sm:pr-4 shrink-0">
                    <a href="m.html"
                        class="text-gray-300 hover:text-cyan-400 whitespace-nowrap transition px-1.5 py-1"><i
                            class="fa-solid fa-mouse text-xs mr-1"></i><span data-i18n="catMouse">เมาส์</span></a>
                    <a href="k.html"
                        class="text-gray-300 hover:text-cyan-400 whitespace-nowrap transition px-1.5 py-1"><i
                            class="fa-solid fa-keyboard text-xs mr-1"></i><span
                            data-i18n="catKeyboard">คีย์บอร์ด</span></a>
                    <a href="h.html"
                        class="text-gray-300 hover:text-cyan-400 whitespace-nowrap transition px-1.5 py-1"><i
                            class="fa-solid fa-headphones text-xs mr-1"></i><span
                            data-i18n="catHeadset">หูฟัง</span></a>
                    <button onclick="filterCategory('notebook')"
                        class="text-gray-300 hover:text-cyan-400 whitespace-nowrap transition px-1.5 py-1"><i
                            class="fa-solid fa-laptop text-xs mr-1"></i><span
                            data-i18n="catNotebook">โน้ตบุ๊ก</span></button>
                    <button onclick="filterCategory('monitor')"
                        class="text-gray-300 hover:text-cyan-400 whitespace-nowrap transition px-1.5 py-1"><i
                            class="fa-solid fa-desktop text-xs mr-1"></i><span
                            data-i18n="catMonitor">จอภาพ</span></button>
                </div>

                <button onclick="openAdminModal()"
                    class="ml-auto text-[11px] sm:text-xs bg-slate-800 hover:bg-slate-700 text-gray-300 px-2.5 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5 shrink-0">
                    <i class="fa-solid fa-gear text-cyan-400"></i> <span data-i18n="adminManage">จัดการสินค้า</span>
                </button>
            </div>
        </div>

    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6">
        <!-- Banner ใหญ่หลัก (Slider) -->
        <div
            class="banner-shine relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl mb-4 border border-cyan-500/30 group">
            <div id="heroSlider"
                class="flex transition-transform duration-500 ease-in-out w-full aspect-[21/9] sm:aspect-[25/9]">
                <img src="photo/bender.jpg" alt="Main Banner 1" class="w-full h-full object-cover flex-shrink-0">
                <img src="photo/1.png" alt="Main Banner 2" class="w-full h-full object-cover flex-shrink-0">
                <img src="photo/2.jpg" alt="Main Banner 3" class="w-full h-full object-cover flex-shrink-0">
            </div>

            <button onclick="prevSlide()"
                class="absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-10 sm:h-10 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 shadow-lg text-xs sm:text-base">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button onclick="nextSlide()"
                class="absolute right-2 sm:right-3 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-10 sm:h-10 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 shadow-lg text-xs sm:text-base">
                <i class="fa-solid fa-chevron-right"></i>
            </button>

            <div id="sliderDots"
                class="absolute bottom-2 sm:bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 sm:gap-2 z-10">
                <button onclick="goToSlide(0)"
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-cyan-400 transition-all"></button>
                <button onclick="goToSlide(1)"
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-white/50 hover:bg-white transition-all"></button>
                <button onclick="goToSlide(2)"
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-white/50 hover:bg-white transition-all"></button>
            </div>
        </div>

        <!-- Banner เล็ก 3 รูป -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mb-8 sm:mb-10">
            <div
                class="banner-shine banner-delay-1 rounded-xl overflow-hidden shadow-lg border border-slate-800 hover:border-cyan-500/50 transition">
                <img src="photo/bender1.jpg" alt="ประกอบคอมเทพ" class="w-full h-auto object-cover">
            </div>
            <div
                class="banner-shine banner-delay-2 rounded-xl overflow-hidden shadow-lg border border-slate-800 hover:border-cyan-500/50 transition">
                <img src="photo/bender2.jpg" alt="จัดชุดสตรีมเมอร์" class="w-full h-auto object-cover">
            </div>
            <div
                class="banner-shine banner-delay-3 rounded-xl overflow-hidden shadow-lg border border-slate-800 hover:border-cyan-500/50 transition">
                <img src="photo/bender3.jpg" alt="คอมลายพรีเมียม" class="w-full h-auto object-cover">
            </div>
        </div>

        <!-- Flash Sale Product Display Section -->
        <section id="flashsale-product-section" class="mb-8 sm:mb-12">
            <div class="flex justify-between items-center mb-4 sm:mb-6 border-b border-red-500/30 pb-3 sm:pb-4">
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-1 sm:w-1.5 h-5 sm:h-7 bg-red-500 rounded-full"></div>
                    <h2 class="text-lg sm:text-2xl font-bold text-white tracking-wide flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-red-500"></i>
                        <span data-i18n="flashSaleProducts">สินค้า Flash Sale</span>
                    </h2>
                </div>
            </div>

            <div id="flashSaleProductGrid"
                class="flex overflow-x-auto gap-3 sm:gap-5 pb-4 scrollbar-thin scroll-smooth snap-x">
            </div>
        </section>

        <!-- Product Display Section -->
        <section id="product-section">
            <div class="flex justify-between items-center mb-4 sm:mb-6 border-b border-slate-800 pb-3 sm:pb-4">
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-1 sm:w-1.5 h-5 sm:h-7 bg-cyan-500 rounded-full"></div>
                    <h2 class="text-lg sm:text-2xl font-bold text-white tracking-wide" data-i18n="recommendedProducts">
                        รายการสินค้าแนะนำ</h2>
                </div>
            </div>

            <div id="productGrid" class="flex overflow-x-auto gap-3 sm:gap-5 pb-4 scrollbar-thin scroll-smooth snap-x">
            </div>
        </section>
        <!-- Promo Double Slider Footer Section -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mt-8 sm:mt-12 mb-8">
            <!-- Promo Slider Left -->
            <div
                class="relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl border border-cyan-500/30 group h-48 sm:h-64 md:h-72 bg-slate-900">
                <div id="promoSlider1" class="flex transition-transform duration-500 ease-in-out h-full">
                    <img src="photo/bender4.jpg" alt="Promo 1-1" class="w-full h-full object-cover flex-shrink-0">
                    <img src="photo/77.png" alt="Promo 1-2" class="w-full h-full object-cover flex-shrink-0">
                    <img src="photo/bender3.jpg" alt="Promo 1-3" class="w-full h-full object-cover flex-shrink-0">
                </div>
                <button onclick="prevPromoSlide(1)"
                    class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 z-10">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
                <button onclick="nextPromoSlide(1)"
                    class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 z-10">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
                <div id="promoDots1" class="absolute bottom-2.5 left-1/2 -translate-x-1/2 flex gap-1.5 z-10"></div>
            </div>

            <!-- Promo Slider Right -->
            <div
                class="relative rounded-xl sm:rounded-2xl overflow-hidden shadow-2xl border border-cyan-500/30 group h-48 sm:h-64 md:h-72 bg-slate-900">
                <div id="promoSlider2" class="flex transition-transform duration-500 ease-in-out h-full">
                    <img src="photo/bender5.png" alt="Promo 2-1" class="w-full h-full object-cover flex-shrink-0">
                    <img src="photo/88.png" alt="Promo 2-2" class="w-full h-full object-cover flex-shrink-0">
                    <img src="photo/bender6.jpg" alt="Promo 2-3" class="w-full h-full object-cover flex-shrink-0">
                </div>
                <button onclick="prevPromoSlide(2)"
                    class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 z-10">
                    <i class="fa-solid fa-chevron-left text-xs"></i>
                </button>
                <button onclick="nextPromoSlide(2)"
                    class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/60 hover:bg-cyan-500 text-white hover:text-black w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center transition opacity-80 sm:opacity-0 group-hover:opacity-100 z-10">
                    <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
                <div id="promoDots2" class="absolute bottom-2.5 left-1/2 -translate-x-1/2 flex gap-1.5 z-10"></div>
            </div>
        </section>
        <!-- Hot / Best-selling Product Display Section -->
        <section id="hot-product-section">
            <div class="flex justify-between items-center mb-4 sm:mb-6 border-b border-slate-800 pb-3 sm:pb-4">
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-1 sm:w-1.5 h-5 sm:h-7 bg-cyan-500 rounded-full"></div>
                    <h2 class="text-lg sm:text-2xl font-bold text-white tracking-wide" data-i18n="hotProducts">
                        รายการสินค้ายอดฮิต</h2>
                </div>
            </div>

            <div id="hotProductGrid" class="flex overflow-x-auto gap-3 sm:gap-5 pb-4 scrollbar-thin scroll-smooth snap-x">
            </div>
        </section>

        <!-- General Product Display Section -->
        <section id="normal-product-section" class="mt-8 sm:mt-12">
            <div class="flex justify-between items-center mb-4 sm:mb-6 border-b border-slate-800 pb-3 sm:pb-4">
                <div class="flex items-center gap-2.5 sm:gap-3">
                    <div class="w-1 sm:w-1.5 h-5 sm:h-7 bg-cyan-500 rounded-full"></div>
                    <h2 class="text-lg sm:text-2xl font-bold text-white tracking-wide" data-i18n="normalProducts">
                        สินค้าทั่วไป</h2>
                </div>
            </div>

            <div id="normalProductGrid"
                class="flex overflow-x-auto gap-3 sm:gap-5 pb-4 scrollbar-thin scroll-smooth snap-x">
            </div>
        </section>

    </main>

    <!-- Modal: Cart -->
    <div id="cartModal" class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 hidden flex justify-end">
        <div class="bg-slate-900 border-l border-slate-800 w-full sm:max-w-md h-full flex flex-col shadow-2xl">
            <div class="p-3.5 sm:p-4 border-b border-slate-800 flex justify-between items-center bg-slate-950">
                <h3 class="font-bold text-base sm:text-lg text-white flex items-center gap-2">
                    <i class="fa-solid fa-cart-shopping text-cyan-400"></i> <span
                        data-i18n="cartTitle">ตะกร้าสินค้า</span>
                </h3>
                <button onclick="toggleCartModal()"
                    class="text-gray-400 hover:text-white text-lg sm:text-xl transition p-1"><i
                        class="fa-solid fa-xmark"></i></button>
            </div>
            <div id="cartItemsContainer" class="flex-1 overflow-y-auto p-3 sm:p-4 space-y-3 sm:space-y-4"></div>
            <div class="p-3.5 sm:p-4 border-t border-slate-800 bg-slate-950 space-y-3">
                <div class="flex justify-between text-sm sm:text-base font-bold text-gray-200">
                    <span data-i18n="totalPrice">ราคารวมทั้งหมด:</span>
                    <span id="cartTotalPrice" class="text-cyan-400 text-lg sm:text-xl font-black">฿0</span>
                </div>
                <button onclick="checkout()"
                    class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-black py-2.5 sm:py-3 rounded-xl shadow-lg shadow-cyan-500/20 text-sm sm:text-base transition"
                    data-i18n="checkoutBtn">สั่งซื้อสินค้า</button>
            </div>
        </div>
    </div>

    <!-- Modal: Auth -->
    <div id="authModal"
        class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 hidden flex justify-center items-center p-3 sm:p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-5 sm:p-6 shadow-2xl relative">
            <button onclick="toggleAuthModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1"><i
                    class="fa-solid fa-xmark text-lg sm:text-xl"></i></button>

            <h3 class="text-lg sm:text-xl font-bold mb-5 text-center text-white" id="authTitle" data-i18n="loginTitle">
                เข้าสู่ระบบ</h3>

            <form id="authForm" onsubmit="handleAuth(event)" class="space-y-3.5">
                <div id="usernameContainer">
                    <label class="block text-xs font-semibold text-gray-400 mb-1" id="authUsernameLabel"
                        data-i18n="userOrEmailLabel">อีเมล / ชื่อผู้ใช้</label>
                    <input type="text" id="authUsername" required
                        class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs sm:text-sm text-white focus:ring-2 focus:ring-cyan-400 focus:outline-none"
                        placeholder="Enter username or email">
                </div>

                <div id="emailContainer" class="hidden">
                    <label class="block text-xs font-semibold text-gray-400 mb-1" data-i18n="emailLabel">อีเมล
                        (Email)</label>
                    <input type="email" id="authEmail"
                        class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs sm:text-sm text-white focus:ring-2 focus:ring-cyan-400 focus:outline-none"
                        placeholder="example@email.com">
                </div>

                <div id="passwordContainer">
                    <div class="flex justify-between items-center mb-1">
                        <label class="text-xs font-semibold text-gray-400" data-i18n="passwordLabel">รหัสผ่าน</label>
                    </div>
                    <input type="password" id="authPassword" required
                        class="w-full p-2.5 bg-slate-800 border border-slate-700 rounded-lg text-xs sm:text-sm text-white focus:ring-2 focus:ring-cyan-400 focus:outline-none"
                        placeholder="••••••••">
                </div>

                <button type="submit" id="authSubmitBtn"
                    class="w-full bg-cyan-500 text-slate-950 font-bold py-2.5 rounded-lg hover:bg-cyan-400 text-xs sm:text-sm shadow-md transition"
                    data-i18n="submitBtn">ตกลง</button>
            </form>

            <p class="text-xs text-center mt-4 text-gray-400" id="authToggleFooter">
                <span id="authToggleText" data-i18n="noAccountText">ยังไม่มีบัญชีใช่ไหม?</span>
                <button onclick="switchAuthMode()" id="authBtnToggle"
                    class="text-cyan-400 font-bold hover:underline ml-1"
                    data-i18n="registerToggleBtn">สมัครสมาชิก</button>
            </p>
        </div>
    </div>

    <!-- Modal: Admin CRUD -->
    <div id="adminModal"
        class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 hidden flex justify-center items-center p-3 sm:p-4">
        <div
            class="bg-slate-900 border border-slate-800 rounded-2xl max-w-xl w-full p-4 sm:p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button onclick="closeAdminModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1"><i
                    class="fa-solid fa-xmark text-lg sm:text-xl"></i></button>
            <h3 class="text-base sm:text-xl font-bold mb-4 border-b border-slate-800 pb-3 text-white"
