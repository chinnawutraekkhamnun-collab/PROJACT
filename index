                    <i class="fa-solid fa-dice"></i> สุ่มคำด่าใหม่
                </button>
                <button onclick="closeCopyWarning()"
                    class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-xl shadow-lg transition transform hover:scale-105 active:scale-95">
                    รับทราบและปิด
                </button>
            </div>
        </div>
    </div>
